# Remove the incorrect file if it exists
Remove-Item -Path .\dockeringnore -ErrorAction SilentlyContinue

# Write a fresh .gitignore
@'
# Python
__pycache__/
*.py[cod]
.pytest_cache/
.env
venv/
env/

# Data & Heavy Binaries
# creditcard.csv
*.joblib

# OS Files
.DS_Store

# Docker ignore
.dockerignore
'@ | Out-File -FilePath .gitignore -Encoding utf8
